# Supabase
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Web Push Notifications - VAPID Keys
# Gerar com: npm install -g web-push && web-push generate-vapid-keys
# 🔐 NUNCA commitar a chave privada! Apenas a pública no frontend.
VITE_VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui

# Servidor/Edge Function (apenas servidor)
# Adicionar no Supabase environment variables se usar Edge Functions
# VAPID_PRIVATE_KEY=sua_chave_privada_vapid_aqui
# VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui

# Email para certificado VAPID (obrigatório pelo padrão Web Push)
# Usar formato: mailto:seu-email@example.com
VITE_VAPID_EMAIL=mailto:seu-email@example.com
